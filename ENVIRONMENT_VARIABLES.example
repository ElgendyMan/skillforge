# SkillForge deployment variable names only. Copy to the destination secret manager; do not commit values.
NODE_ENV=development
PORT=3000
DATABASE_URL=<set-in-deployment>
JWT_SECRET=<set-in-deployment>
VITE_APP_ID=<set-in-deployment>
OAUTH_SERVER_URL=<set-in-deployment>
VITE_OAUTH_PORTAL_URL=<set-in-deployment>
OWNER_OPEN_ID=<set-in-deployment>
BUILT_IN_FORGE_API_URL=<set-in-deployment>
BUILT_IN_FORGE_API_KEY=<set-in-deployment>
VITE_FRONTEND_FORGE_API_URL=<set-in-deployment>
VITE_FRONTEND_FORGE_API_KEY=<set-in-deployment>
RESEND_API_KEY=<set-in-deployment>
RESEND_FROM_EMAIL=<verified-sender>
VITE_ANALYTICS_ENDPOINT=<optional>
VITE_ANALYTICS_WEBSITE_ID=<optional>
SUPABASE_URL=<destination-project-url>
SUPABASE_ANON_KEY=<destination-public-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
